div>\n</div>\n<button aria-label="Pause Background" class="background-pause-button"></button>\n<button aria-label="Play Background" class="background-pause-button paused"></button>\n</div>\n</section>\n<section class="page-section user-items-list-section full-bleed-section light-bold" data-animation="" data-controller="SectionWrapperController" data-current-context=\'{"video":{"filter":1,"videoFallbackContentItem":null,"nativeVideoContentItem":null,"videoSourceProvider":"none"},"backgroundImageId":null,"backgroundMediaEffect":{"type":"none"},"divider":{"enabled":false},"typeName":"page"}\' data-current-styles=\'{"imageFocalPoint":{"x":0.5,"y":0.5},"imageOverlayOpacity":0.3,"sectionTheme":"light-bold","imageEffect":"none","backgroundMode":"image","backgroundImage":null}\' data-json-schema-section="" data-section-id="66fbbcc3c529073a5a80ee13" data-section-theme="light-bold" data-sqsp-section="auto-layout" data-test="page-section">\n<div class="section-border">\n<div class="section-background">\n</div>\n</div>\n<div class="content-wrapper" style="\n      \n        \n      \n    ">\n<div class="content">\n<div class="user-items-list" data-card-theme="" data-layout-width="inset" data-section-id="user-items-list" data-section-title-enabled="true" data-space-below-section-title-unit="px" data-space-below-section-title-value="40" style="\n    min-height: 100px;\n    padding-top: 6.6vmax;\n    padding-bottom: 6.6vmax;\n    ">\n<div class="list-section-title" data-section-title-alignment="center" id="66fbbcc3c529073a5a80ee13" style="padding-bottom: 40px;">\n<p class="" style="white-space:pre-wrap;">Some of Our Team</p>\n</div>\n\n<ul class="user-items-list-item-container user-items-list-simple" data-alignment-vertical="top" data-body-alignment="left" data-body-placement="center" data-button-alignment="left" data-button-font-unit="rem" data-button-placement="center" data-content-order="media-first" data-controller="UserItemsListSimple" data-current-context="{\n&quot;userItems&