;: &quot;d2d5e4&quot;,\n&quot;topRightAverage&quot;: &quot;dddfeb&quot;,\n&quot;bottomLeftAverage&quot;: &quot;e5e9f2&quot;,\n&quot;bottomRightAverage&quot;: &quot;e4e7ed&quot;,\n&quot;centerAverage&quot;: &quot;5e4842&quot;,\n&quot;suggestedBgColor&quot;: &quot;a6a6af&quot;\n},\n&quot;urlId&quot;: &quot;7xh6gzmrx5ai9m47wlxdh05zsqo33q&quot;,\n&quot;title&quot;: &quot;&quot;,\n&quot;body&quot;: null,\n&quot;likeCount&quot;: 0,\n&quot;commentCount&quot;: 0,\n&quot;publicCommentCount&quot;: 0,\n&quot;commentState&quot;: 2,\n&quot;unsaved&quot;: false,\n&quot;assetUrl&quot;: &quot;https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg&quot;,\n&quot;contentType&quot;: &quot;image/jpeg&quot;,\n&quot;items&quot;: [ ],\n&quot;pushedServices&quot;: { },\n&quot;pendingPushedServices&quot;: { },\n&quot;originalSize&quot;: &quot;1667x1667&quot;,\n&quot;recordTypeLabel&quot;: &quot;image&quot;\n}\n}, {\n&quot;title&quot;: &quot;Cara Labrador&quot;,\n&quot;description&quot;: &quot;&lt;p class=\\&quot;\\&quot; data-rte-preserve-empty=\\&quot;true\\&quot; style=\\&quot;white-space:pre-wrap;\\&quot;&gt;FRONTIER SECURITY&lt;\\/p&gt;&lt;p class=\\&quot;\\&quot; data-rte-preserve-empty=\\&quot;true\\&quot; style=\\&quot;white-space:pre-wrap;\\&quot;&gt;Cara is a Senior Researcher with a background in the intersection of technology and national security. Prior to IAPS, Cara worked in the Global Technology Practice of Beacon Global Strategies, a national security advisory firm based in Washington, D.C. In this role, she helped leading technology companies navigate both the U.S. and global tech governance landscapes, align R&amp;amp;D efforts with national security priorities, and enhance policymakers’ understanding of emerging technologies. Cara previously served as an Editorial Associate at the Council on Foreign Relations, a Fulbright Scholar in Bogota, Colombia, and an intern with the U.S. Department of State, USAID, the United Nations Secretariat, and the European Union External Action Service.&lt;\\/p&gt;&quot;,\n&quot;button&quot;: {\n&quot;buttonText&quot;: &quot;Read Bio&quot;,\n&quot;buttonLink&quot;: &quot;&quot;\n},\n&quot;imageId&quot;: &quot;69d54feb5bee8b5a97ecab05&quot;,\n&quot;image&quot;: {\n&quot;id&quot;: &quot;69d54feb5bee8b5a97ecab05&quot;,\n&quot;recordType&quot;: 2,\n&quot;addedOn&quot;: 1775587307619,\n&quot;updatedOn&quot;: 1775587307656,\n&quot;workflowState&quot;: 1,\n&quot;publishOn&quot;: 1775587307619,\n&quot;authorId&quot;: &quot;696fbff22f7f2d6fe7ef6507&quot;,\n&quot;systemDataId&quot;: &quot;44591de3-f756-4735-9fb8-d1f09930b6b1&quot;,\n&quot;systemDataVariants&quot;: &quot;5472x3648,100w,300w,500w,750w,1000w,1500w,2500w&quot;,\n&quot;systemDataSourceType&quot;: &quot;JPG&quot;,\n&quot;filename&quot;: &quot;IAPS Headshots - Jason Dixson Photography - 251022 - 230312 - 4829.jpg&quot;,\n&quot;mediaFocalPoint&quot;: {\n&quot;x&quot;: 0.5,\n&quot;y&quot;: 0.5,\n&quot;source&quot;: 3\n},\n&quot;colorData&quot;: {\n&quot;topLeftAverage&quot;: &quot;d1d3e1&quot;,\n&quot;topRightAverage&quot;: &quot;c8cad7&quot;,\n&quot;bottomLeftAverage&quot;: &quot;f4f5fb&quot;,\n&quot;bottomRightAverage&quot;: &quot;e9ecf6&quot;,\n&quot;centerAverage&quot;: &quot;dee1ed&quot;,\n&quot;suggestedBgColor&quot;: &quot;cfccd1&quot;\n},\n&quot;urlId&quot;: &quot;ag1ztkxogouxi4rg5ykxiebh5do7b6&quot;,\n&quot;title&quot;: &quot;&quot;,\n&quot;body&quot;: null,\n&quot;likeCount&quot;: 0,\n&quot;commentCount&quot;: 0,\n&quot;publicCommentCount&quot;: 0,\n&quot;commentState&quot;: 2,\n&quot;unsaved&quot;: false,\n&quot;assetUrl&quot;: &quot;https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg&quot;,\n&quot;contentType&quot;: &quot;image/jpeg&quot;,\n&quot;items&quot;: [ ],\n&quot;pushedServices&quot;: { },