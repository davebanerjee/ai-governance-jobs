/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg" decoding="async" elementtiming="nbf-list-simple" height="1667" loading="lazy" sizes="(max-width: 575px) calc((100vw - 0px) / 1), (max-width: 767px) calc((100vw - 100px) / 2), (max-width: 1099px) calc((100vw - 200px) / 3), (max-width: 1199px) calc((100vw - 200px) / 3), calc((100vw - 200px) / 3)" src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg" srcset="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=2500w 2500w" style="display:block;object-position: 50% 50%;" width="1667"/></div>\n</div>\n<div class="list-item-content">\n<div class="list-item-content__text-wrapper">\n<h2 class="list-item-content__title" style="max-width: 100%;">Renan Araujo</h2>\n<div class="list-item-content__description" style="\n            margin-top: 1%;\n            max-width: 100%;\n          ">\n<p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">PROGRAMS</p><p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">Renan is the Director of Programs at IAPS. He leads the AI Policy Fellowship, the Alexandria Forum, and IAPS\'s portfolio of talent and field-building projects. Renan is also a research affiliate at the Oxford AI Governance Initiative. Renan has been a member of the UN Council of Presidents expert panel on AGI, a fellow of the Oxford China Policy Lab, and the research manager leading IAPS\'s International Strategy team. Before joining IAPS, Renan was research manager on AI and emerging technologies at Rethink Priorities, director and cofounder of the Condor Initiative, predoctoral research fellow at the Institute for Law and AI, and a chief of staff to justices of appeal at a state court in Brazil.</p>\n</div>\n</div>\n</div>\n</li>\n<li class="list-item" data-is-card-enabled="false" style="\n        \n      ">\n<div class="list-item-media" style="\n          \n            margin-bottom: 4%;\n          \n          width: 100%;\n        ">\n<div class="list-item-media-inner" data-animation-role="image" data-aspect-ratio="1:1">\n<img alt="" class="list-image" data-image="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg" data-image-dimensions="5472x3648" data-image-focal-point="0.5,0.5" data-load="false" data-loader="sqs" data-src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg" decoding="async" elementtiming="nbf-list-simple" height="3648" loading="lazy" sizes="(max-width: 575px) calc((100vw - 0px) / 1 * 1.5), (max-width: 767px) calc((100vw - 100px) / 2 * 1.5), (max-width: 1099px) calc((100vw - 200px) / 3 * 1.5), (max-width: 1199px) calc((100vw - 200px) / 3 * 1.5), calc((100vw - 200px) / 3 * 1.5)" src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg" srcset="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=2500w 2500w" style="display:block;object-position: 50% 50%;" width="5472"/></div>\n</div>\n<div class="list-item-content">\n<div class="list-item-content__text-wrapper">\n<h2 class="list-item-content__title" style="max-width: 100%;">Cara Labrador</h2>\n<div class="list-item-content__description" style="\n            margin-top: 1%;\n            max-width: 100%;\n          ">\n<p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">FRONTIER SECURITY</p><p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">Cara is a Senior Researcher with a background in the intersection of technology and national security. Prior to IAPS, Cara worked in the Global Technology Practice of Beacon Global Strategies, a national security advisory firm based in Washington, D.C. In this role, she helped leading technology companies navigate both the U.S. and global tech governance landscapes, align R&amp;D efforts with national security priorities, and enhance policymakers’ understanding of emerging technologies. Cara previously served as an Editorial Associate at the Council on Foreign Relations, a Fulbright Scholar in Bogota, Colombia, and an intern with the U.S. Department of State, USAID, the United Nations Secretariat, and the European Union External Action Service.</p>\n</div>\n</div>\n</div>\n</li>\n<li class="list-item" data-is-card-enabled="false" style="\n        \n      ">\n<div class="list-item-media" style="\n          \n            margin-bottom: 4%;\n          \n          width: 100%;\n        ">\n<div class="list-item-media-inner" data-animation-role="image" data-aspect-ratio="1:1">\n<img alt="" class="list-image" data-image="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg" data-image-dimensions="5472x3648" data-image-focal-point="0.5,0.5" data-load="false" data-loader="sqs" data-src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg" decoding="async" elementtiming="nbf-list-simple" height="3648" loading="lazy" sizes="(max-width: 575px) calc((100vw - 0px) / 1 * 1.5), (max-width: 767px) calc((100vw - 100px) / 2 * 1.5), (max-width: 1099px) calc((100vw - 200px) / 3 * 1.5), (max-width: 1199px) calc((100vw - 200px) / 3 * 1.5), calc((100vw - 200px) / 3 * 1.5)" src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg" srcset="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/10772c55-2f4c-4bd8-8687-65652bca6a17/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230354+-+8425.jpg?format=2500w 2500w" style="display:block;object-position: 50% 50%;" width="5472"/></div>\n</div>\n<div class="list-item-content">\n<div class="list-item-content__text-wrapper">\n<h2 class="list-item-content__title" style="max-width: 100%;">Dave Banerjee</h2>\n<div class="list-item-content__description" style="\n            margin-top: 1%;\n            max-width: 100%;\n          ">\n<p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">COMPUTE POLICY</p><p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">Dave is a Research Associate on the Compute Policy team, focusing on AI integrity, AI security and governance, and AI-driven power concentration. He is also a research manager at ERA Cambridge in the technical AI governance stream. Dave is an alumni of the IAPS Policy Fellowship, and prior to joining IAPS he participated in the GovAI summer fellowship, ARENA (Alignment Research Engineer Accelerator), and SPAR (Supervised Program for Alignment Research).</p>\n</div>\n</div>\n</div>\n</li>\n</ul>\n</div>\n</div>\n</div>\n</section>\n<section class="page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--custom content-width--wide horizontal-alignment--center vertical-alignment--middle" data-animation="none" data-controller="SectionWrapperController" data-current-context=\'{"video":{"playbackSpeed":0.5,"filter":1,"filterStrength":0,"zoom":0,"videoSourceProvider":"none"},"backgroundImageId":null,"backgroundMediaEffect":{"type":"none"},"divider":{"enabled":false},"typeName":"page"}\' data-current-styles=\'{"imageOverlayOpacity":0.15,"backgroundWidth":"background-width--full-bleed","sectionHeight":"section-height--custom","customSectionHeight":0,"horizontalAlignment":"horizontal-alignment--center","verticalAlignment":"vertical-alignment--middle","contentWidth":"content-width--wide","customContentWidth":50,"sectionTheme":"","sectionAnimation":"none","backgroundMode":"image"