750w 750w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg?format=2500w 2500w" style="display:block;object-position: 50% 50%;" width="1667"/></div>\n</div>\n<div class="list-item-content">\n<div class="list-item-content__text-wrapper">\n<h2 class="list-item-content__title" style="max-width: 100%;">Renan Araujo</h2>\n<div class="list-item-content__description" style="\n            margin-top: 1%;\n            max-width: 100%;\n          ">\n<p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">PROGRAMS</p><p class="" data-rte-preserve-empty="true" style="white-space:pre-wrap;">Renan is the Director of Programs at IAPS. He leads the AI Policy Fellowship, the Alexandria Forum, and IAPS\'s portfolio of talent and field-building projects. Renan is also a research affiliate at the Oxford AI Governance Initiative. Renan has been a member of the UN Council of Presidents expert panel on AGI, a fellow of the Oxford China Policy Lab, and the research manager leading IAPS\'s International Strategy team. Before joining IAPS, Renan was research manager on AI and emerging technologies at Rethink Priorities, director and cofounder of the Condor Initiative, predoctoral research fellow at the Institute for Law and AI, and a chief of staff to justices of appeal at a state court in Brazil.</p>\n</div>\n</div>\n</div>\n</li>\n<li class="list-item" data-is-card-enabled="false" style="\n        \n      ">\n<div class="list-item-media" style="\n          \n            margin-bottom: 4%;\n          \n          width: 100%;\n        ">\n<div class="list-item-media-inner" data-animation-role="image" data-aspect-ratio="1:1">\n<img alt="" class="list-image" data-image="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg" data-image-dimensions="5472x3648" data-image-focal-point="0.5,0.5" data-load="false" data-loader="sqs" data-src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg" decoding="async" elementtiming="nbf-list-simple" height="3648" loading="lazy" sizes="(max-width: 575px) calc((100vw - 0px) / 1 * 1.5), (max-width: 767px) calc((100vw - 100px) / 2 * 1.5), (max-width: 1099px) calc((100vw - 200px) / 3 * 1.5), (max-width: 1199px) calc((100vw - 200px) / 3 * 1.5), calc((100vw - 200px) / 3 * 1.5)" src="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg" srcset="https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/44591de3-f756-4735-9fb8-d1f09930b6b1/IAPS+Headshots+-+Jason+Dixson+Photography+-+251022+-+230312+-+4829.jpg?format=750w 750w, htt