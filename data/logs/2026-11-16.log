opener noreferrer" target="_blank" title="Share on LinkedIn">\n<i class="fa-brands fa-linkedin-in"></i>\n<span class="btn-link-label">LinkedIn</span>\n</a>\n</li>\n<li>\n<a class="share-button btn-link" href="https://bsky.app/intent/compose?text=Jobs:%20https%3A%2F%2Fecfr.eu%2Fjobs%2F" rel="noopener noreferrer" target="_blank" title="Share on Bluesky">\n<i class="fa-brands fa-bluesky"></i>\n<span class="btn-link-label">Bluesky</span>\n</a>\n</li>\n<li>\n<a class="share-button btn-link" href="https://twitter.com/intent/tweet?source=https%3A%2F%2Fecfr.eu&amp;text=Jobs:%20https%3A%2F%2Fecfr.eu%2Fjobs%2F&amp;via=ecfr" rel="noopener noreferrer" target="_blank" title="Share on X">\n<i class="fa-brands fa-x-twitter"></i>\n<span class="btn-link-label">Tweet</span>\n</a>\n</li>\n<li>\n<a class="share-button btn-link" href="https://api.whatsapp.com/send/?text=https%3A%2F%2Fecfr.eu%2Fjobs%2F" rel="noopener noreferrer" target="_blank" title="Share on WhatsApp">\n<i class="fa-brands fa-whatsapp fa-fw"></i>\n<span class="btn-link-label">WhatsApp</span>\n</a>\n</li>\n</ul>\n</div>\n</div>\n<div class="article-main">\n<div class="text-body">\n<h2 class="wp-block-heading" id="working-at-ecfr">Working at ECFR\xa0</h2>\n<p class="wp-block-paragraph">The European Council on Foreign Relations is an award-winning international think-tank that aims to conduct cutting-edge independent research on European foreign and security policy and to provide a safe meeting space for decision-makers, experts, and influencers to share ideas. We build coalitions for change at the European level and promote informed debate about Europe’s role in the world. ECFR is uniquely placed to provide a pan-European perspective on some of the biggest strategic challenges and choices Europeans need to confront, with a network of offices in seven European capitals. <a data-id="https://ecfr.eu/about/" data-type="URL" href="https://ecfr.eu/about/">Find out more about ECFR</a>.\xa0</p>\n<h2 class="wp-block-heading" id="joining-ecfr">Joining ECFR\xa0</h2>\n<p class="wp-block-paragraph">With 100 staff members across seven European capitals, each member of the team makes a vital contribution to our impact. We emphasise selecting individuals who strongly identify with ECFR’s mission and embrace our organisational culture.\xa0</p>\n<p class="wp-block-paragraph">ECFR is an equal-opportunity employer and is committed to support the personal and professional development of its staff irrespective of their gender, nationality, religion, disability, age, cultural background, or sexual identity.\xa0</p>\n<h3 class="wp-block-heading" id="we-look-for-people-who">We look for people who:\xa0</h3>\n<ul class="wp-block-list">\n<li>are strategic, curious, and creative;\xa0</li>\n<li>have an agile and entrepreneurial mindset;\xa0</li>\n<li>show the desire and knowledge to translate research into practical, policy-driven solutions;\xa0</li>\n<li>are committed to a process of ongoing learning;\xa0</li>\n<li>act with humility, generosity, and integrity towards others;\xa0</li>\n<li>demonstrate flexibility, adaptability, and ease in working in fast-paced environments;\xa0</li>\n<li>have strong planning, problem-solving, and self-organising skills.\xa0</li>\n</ul>\n<h3 class="wp-block-heading" id="we-offer">We offer:\xa0</h3>\n<ul class="wp-block-list">\n<li>High level of personal responsibility\xa0</li>\n<li>Highly motivated and brilliant colleagues from across Europe\xa0</li>\n<li>Competitive compensation\xa0</li>\n<li>Generous annual leave allowance\xa0</li>\n<li>Flexible working\xa0</li>\n</ul>\n</div>\n</div>\n<div class="sidebar-right hide-print">\n<div class="sticky row-gap">\n<div class="widget toc-container hide" id="toc">\n\n</div>\n</div>\n</div>\n</section>\n\n</div>\n</section>'}], 'model': 'claude-haiku-4-5'}}
