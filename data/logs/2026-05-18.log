em": null,\n"videoSourceProvider": "none"\n},\n"backgroundImageId": null,\n"backgroundMediaEffect": {\n"type": "none"\n},\n"divider": {\n"enabled": false\n},\n"typeName": "page"\n}\' data-current-styles=\'{\n"imageFocalPoint": {\n"x": 0.5,\n"y": 0.5\n},\n"imageOverlayOpacity": 0.3,\n"sectionTheme": "light-bold",\n"imageEffect": "none",\n"backgroundMode": "image",\n"backgroundImage": null\n}\' data-json-schema-section="" data-section-id="66fbbcc3c529073a5a80ee13" data-section-theme="light-bold" data-sqsp-section="auto-layout" data-test="page-section">\n<div class="section-border">\n<div class="section-background">\n</div>\n</div>\n<div class="content-wrapper" style="\n      \n        \n      \n    ">\n<div class="content">\n<div class="user-items-list" data-card-theme="" data-layout-width="inset" data-section-id="user-items-list" data-section-title-enabled="true" data-space-below-section-title-unit="px" data-space-below-section-title-value="40" style="\n    min-height: 100px;\n    padding-top: 6.6vmax;\n    padding-bottom: 6.6vmax;\n    ">\n<div class="list-section-title" data-section-title-alignment="center" id="66fbbcc3c529073a5a80ee13" style="padding-bottom: 40px;">\n<p class="" style="white-space:pre-wrap;">Some of Our Team</p>\n</div>\n\n<ul class="user-items-list-item-container user-items-list-simple" data-alignment-vertical="top" data-body-alignment="left" data-body-placement="center" data-button-alignment="left" data-button-font-unit="rem" data-button-placement="center" data-content-order="media-first" data-controller="UserItemsListSimple" data-current-context="{\n&quot;userItems&quot;: [ {\n&quot;title&quot;: &quot;Renan Araujo&quot;,\n&quot;description&quot;: &quot;&lt;p class=\\&quot;\\&quot; data-rte-preserve-empty=\\&quot;true\\&quot; style=\\&quot;white-space:pre-wrap;\\&quot;&gt;PROGRAMS&lt;\\/p&gt;&lt;p class=\\&quot;\\&quot; data-rte-preserve-empty=\\&quot;true\\&quot; style=\\&quot;white-space:pre-wrap;\\&quot;&gt;Renan is the Director of Programs at IAPS. He leads the AI Policy Fellowship, the Alexandria Forum, and IAPS\'s portfolio of talent and field-building projects. Renan is also a research affiliate at the Oxford AI Governance Initiative. Renan has been a member of the UN Council of Presidents expert panel on AGI, a fellow of the Oxford China Policy Lab, and the research manager leading IAPS\'s International Strategy team. Before joining IAPS, Renan was research manager on AI and emerging technologies at Rethink Priorities, director and cofounder of the Condor Initiative, predoctoral research fellow at the Institute for Law and AI, and a chief of staff to justices of appeal at a state court in Brazil.&lt;\\/p&gt;&quot;,\n&quot;button&quot;: {\n&quot;buttonText&quot;: &quot;Read Bio&quot;\n},\n&quot;imageId&quot;: &quot;69d54f9cfb45041be39d22c5&quot;,\n&quot;image&quot;: {\n&quot;id&quot;: &quot;69d54f9cfb45041be39d22c5&quot;,\n&quot;recordType&quot;: 2,\n&quot;addedOn&quot;: 1775587228202,\n&quot;updatedOn&quot;: 1775587228245,\n&quot;workflowState&quot;: 1,\n&quot;publishOn&quot;: 1775587228202,\n&quot;authorId&quot;: &quot;696fbff22f7f2d6fe7ef6507&quot;,\n&quot;systemDataId&quot;: &quot;a834d9da-d62a-42c8-8c6b-10f469995557&quot;,\n&quot;systemDataVariants&quot;: &quot;1667x1667,100w,300w,500w,750w,1000w,1500w&quot;,\n&quot;systemDataSourceType&quot;: &quot;JPG&quot;,\n&quot;filename&quot;: &quot;IAPS Headshots - Jason Dixson Photography - 251020 - 203722 - 2869.jpg&quot;,\n&quot;mediaFocalPoint&quot;: {\n&quot;x&quot;: 0.5,\n&quot;y&quot;: 0.5,\n&quot;source&quot;: 3\n},\n&quot;colorData&quot;: {\n&quot;topLeftAverage&quot;: &quot;d2d5e4&quot;,\n&quot;topRightAverage&quot;: &quot;dddfeb&quot;,\n&quot;bottomLeftAverage&quot;: &quot;e5e9f2&quot;,\n&quot;bottomRightAverage&quot;: &quot;e4e7ed&quot;,\n&quot;centerAverage&quot;: &quot;5e4842&quot;,\n&quot;suggestedBgColor&quot;: &quot;a6a6af&quot;\n},\n&quot;urlId&quot;: &quot;7xh6gzmrx5ai9m47wlxdh05zsqo33q&quot;,\n&quot;title&quot;: &quot;&quot;,\n&quot;body&quot;: null,\n&quot;likeCount&quot;: 0,\n&quot;commentCount&quot;: 0,\n&quot;publicCommentCount&quot;: 0,\n&quot;commentState&quot;: 2,\n&quot;unsaved&quot;: false,\n&quot;assetUrl&quot;: &quot;https://images.squarespace-cdn.com/content/v1/64edf8e7f2b10d716b5ba0e1/a834d9da-d62a-42c8-8c6b-10f469995557/IAPS+Headshots+-+Jason+Dixson+Photography+-+251020+-+203722+-+2869.jpg&quot;,\n&quot;contentType&quot;: &quot;image/jpeg&quot;,\n&quot;items&quot;: [ ],\n&quot;pushedServices&quot;: { },\n&quot;pendingPushedServices&quot;: { },\n&quot;originalSize&quot;: &quot;1667x1667&quot;,\n&quot;recordTypeLabel&quot;: &quot;image&quot;\n}\n}, {\n&quot;title&quot;: &quot;Cara Labrador&quot;,\n&quot;description&quot;: &quot;&lt;p class=\\&quot;\\&quot; data-rte-preserve-empty=\\&quot;true\\&quot; style=\\&quot;white-space:pre-wrap;\\&quot;&gt;FRONTIER SECURITY&lt;\\/p&gt;&lt;p class=\\&quot;\\&quot; data-rte-preserve-empty=\\&quot;true\\&quot; style=\\&quot;white-space:pre-wrap;\\&quot;&gt;Cara is a Senior Researcher with a background in the intersection of technology and national security. Prior to IAPS, Cara worked in the Global Technology Practice of Beacon Global Strategies, a national security advisory firm based in Washington, D.C. In this role, she helped leading technology companies navigate both the U.S. and global tech governance landscapes, align R&amp;amp;D efforts with national security priorities, and enhance policymakers’ understanding of emerging technologies. Cara previously served as an Editorial Associate at the Council on Foreign Relations, a Fulbright Scholar in Bogota, Colombia, and an intern with the U.S. Department of State, USAID, the United Nations Secretariat, and the European Union External Action Service.&lt;\\/p&gt;&quot;,\n&quot;button&quot;: {\n&quot;buttonText&quot;: &quot;Read Bio&quot;,\n&quot;buttonLink&quot;: &quot;&quot;\n},\n&quot;imageId&quot;: &quot;69d54feb5bee8b5a97ecab05&quot;,\n&quot;image&quot;: {\n&quot;id&quot;: &quot;69d54feb5bee8b