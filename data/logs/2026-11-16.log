2026-11-16 19:24:20,904 [DEBUG] anthropic._base_client: Request options: {'method': 'post', 'url': '/v1/messages', 'headers': {}, 'timeout': {'connect': 5.0, 'read': 600, 'write': 600, 'pool': 600}, 'files': None, 'idempotency_key': 'stainless-python-retry-9c39ed2e-02e6-4a25-8767-d42700d00bca', 'span_name': 'anthropic.messages.create', 'span_route': '/v1/messages', 'span_attributes': <function messages_create_request_attributes at 0x7bb98d027100>, 'content': None, 'json_data': {'max_tokens': 4096, 'messages': [{'role': 'user', 'content': 'Extract all job/position listings from this career page HTML.\nReturn a JSON array where each element has:\n- "title": job title string\n- "url": full URL to the job posting (resolve relative URLs against https://www.brookings.edu/careers/)\n- "location": location if mentioned, else null\n- "role_type": "Full-time", "Part-time", "Fellowship", "Internship", or null\n\nOnly include actual job openings, internships, and fellowships.\nIgnore navigation links, news articles, blog posts, event listings, etc.\nIf there are no job listings on the page, return an empty array: []\nReturn ONLY valid JSON, no other text.\n\n---\n\n<main id="main">\n<section id="hero">\n<div class="hero byo--with-hero-2 pt-5 pb-5 lg:pt-6 lg:pb-7">\n<div class="grid grid-cols-1 md:grid-cols-12 gap-5 hero-content px-0 md:px-outer gap-5">\n<div class="left-col md:col-span-6 lg:col-span-7 xl:col-span-8 contents md:flex">\n<div class="collection-logo w-full flex flex-col order-1 px-outer md:px-0 col-span-1">\n<h1 class="collection-logo research-landing-headline">\n\t\t\t\t\tCareers\n\t\t\t\t</h1>\n</div>\n</div>\n<div class="right-col md:col-span-6 lg:col-span-5 xl:col-span-4 contents md:flex">\n<div class="collection-description order-3 mx-outer md:mx-0 flex flex-col border-b border-skin-hr-secondary md:border-b-0 pb-5 md:pb-0 col-span-1 md:min-h-[105px]">\n<div class="medium mt-2 wysiwyg">\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class="research-center-subpage-nav">\n<div class="research-center-subpage-nav__inner flex flex-col md:flex-row items-start md:items-center justify-between mx-outer pb-3 md:pb-0">\n<div class="wrapper">\n<ul class="flex flex-col md:flex-row items-start pl-0 gap-1 md:gap-5">\n<li class="">\n<a class="medium" href="https://careers-brookings.icims.com/jobs/search?ss=1&amp;hashed=-435682078">\n\t\t\t\t\t\t\tJob Openings\n\t\t\t\t\t\t</a>\n</li>\n<li class="">\n<a class="medium" href="https://www.brookings.edu/careers/internships/">\n\t\t\t\t\t\t\tInternships\n\t\t\t\t\t\t</a>\n</li>\n<li class="">\n<a class="medium" href="https://www.brookings.edu/careers/benefits/">\n\t\t\t\t\t\t\tBenefits\n\t\t\t\t\t\t</a>\n</li>\n<li class="">\n<a class="medium" href="https://www.brookings.edu/careers/professional-development/">\n\t\t\t\t\t\t\tProfessional Development\n\t\t\t\t\t\t</a>\n</li>\n<li class="">\n<a class="medium" href="https://www.brookings.edu/careers/our-culture/">\n\t\t\t\t\t\t\tOur Culture\n\t\t\t\t\t\t</a>\n</li>\n</ul>\n</div>\n</div>\n</div>\n</section>\n<section id="content">\n<template id="tweet-it">\n<div class="tweet-it" hidden="">\n<button class="btn btn-social group" clickable="" url="https://twitter.com/intent/tweet?text={text}">\n\n</button>\n</div>\n</template>\n<div class="byo-blocks -with-sidebars article-content border-t border-skin-hr-secondary pt-5 lg:pt-nav">\n<aside class="sidebar sidebar-left flex">\n<div class="sidebar-block sections">\n<div class="block-wrapper flex flex-col gap-3">\n<span class="text-h5">Sections</span>\n<ul class="section-links" uk-scrollspy-nav="closest: li; offset: 40">\n</ul>\n</div>\n<aside aria-label="Section navigation" class="sticky-sections js-sticky-controller">\n<div class="sticky-sections-wrapper flex h-screen">\n\n<div aria-controls="sticky-section-links" aria-pressed="false" class="section-toggle-container" role="button" tabindex="0">\n<div aria-controls="sticky-section-links" aria-expanded="true" aria-label="Toggle section navigation" class="sticky-toggle-btn js-sticky-toggle">\n<span aria-hidden="true" class="toggle-icon expanded">\n<!-- X icon -->\n\n</span>\n<span aria-hidden="true" class="toggle-icon collapsed">\n<!-- List icon -->\n\n</span>\n<span class="sr-only">Toggle section navigation</span>\n</div>\n<span class="section-label">Sections</span>\n</div>\n</div>\n</aside>\n</div>\n<div aria-hidden="true" class="js-sticky-trigger-marker" style="height: 1px;"></div>\n</aside>\n<aside class="sidebar sidebar-right contents lg:flex">\n</aside>\n<div class="byo-block -narrow wysiwyg-block wysiwyg">\n<h2 style="text-align: center;">Are you ready to make an impact?</h2>\n</div>\n<div class="byo-block -narrow wysiwyg-block wysiwyg -has-drop-cap">\n<p>Welcome to Brookings, where your career has the power to drive meaningful change. Whether you’re an emerging talent seeking an entry-level position or an experienced professional aiming for advancement, we provide a range of career opportunities in research and non-research roles. Joining our team means becoming part of a diverse and inclusive community that values your skills and nurtures your development. You’ll have access to cutting-edge resources, collaborate with experts in their fields, and contribute to shaping policies and ideas that have a real-world impact.</p>\n<p>Explore our current opportunities and take the next step in your professional journey.</p>\n</div>\n<div class="byo-block -narrow wysiwyg-block wysiwyg">\n<p style="text-align: center;"><a class="btn px-[28px] sm:w-fit" href="https://careers-brookings.icims.com/jobs/search?ss=1&amp;hashed=-435682078" role="button" style="margin-right:30px;">Job Openings</a><a class="btn px-[28px] sm:w-fit" href="https://www.brookings.edu/careers/internships/" role="button" style="margin-left:30px;">Internships</a></p>\n</div>\n<div class="byo-block -wide testimonials-section px-outer overflow-hidden w-screen -ml-outer mt-5 mb-7 theme-dark-blue">\n<hr/> <div class="testimonials-content">\n<div class="testimonial-swiper swiper-container relative">\n<div class="swiper-controls pt-3 pb-5">\n<div class="swiper-title">\n<h2>What it\'s like to work at Brookings</h2>\n</div>\n<div class="swiper-nav">\n<div class="swiper-button-prev btn text-btn">\n\n</div>\n<div class="swiper-button-next btn text-btn">\n\n</div>\n</div>\n</div>\n<div class="swiper-wrapper" equalize-row="">\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>Brookings is a unique and exciting place to work because there are so many ways to plug into the groundbreaking and substantive research that takes place every day. From research to operations to communications and engagements, it takes teamwork to make our work as impactful as possible. That teamwork is one of the best parts of working at Brookings, and the lasting connections I’ve made with colleagues across the Institution makes me feel engaged and supported.</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?quality=50&amp;w=1500" srcset="https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg 3822w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=150,150 150w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=300,300 300w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=768,768 768w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=1024,1024 1024w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=1536,1536 1536w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=2048,2048 2048w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=100,100 100w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=250,250 250w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=500,500 500w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=1000,1000 1000w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=1500,1500 1500w, https://www.brookings.edu/wp-content/uploads/2025/07/B-PORT-01225.jpg?resize=2000,2000 2000w"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="">\n<h5>Jonathan Buechner</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Development Officer, Individual Giving</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="">Development</a></span></span> </span>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>Brookings is an excellent workplace that pairs inclusiveness with collegiately for those who are interested in learning a broad range of policy issues within or beyond their work functions and being exposed to or challenged by distinct ideas. The intellectual platform that Brookings provides constantly encourages me to learn about issues affecting various groups and reflect upon my role and responsibility as an individual in this fast-changing world.</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?quality=50&amp;w=1500" srcset="https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg 2799w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=150,150 150w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=300,300 300w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=768,768 768w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=1024,1024 1024w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=1536,1536 1536w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=2048,2048 2048w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=100,100 100w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=250,250 250w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=500,500 500w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=1000,1000 1000w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=1500,1500 1500w, https://www.brookings.edu/wp-content/uploads/2024/07/Haowen.jpg?resize=2000,2000 2000w" style="object-position: 49.80% 24.00%;"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="">\n<h5>Haowen Chen</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Senior Project Manager</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="">Economic Studies, The Hutchins Center of Fiscal and Monetary Policy</a></span></span> </span>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>It is no understatement to say that Brookings has placed me as close to decisionmakers on climate justice than I’ve ever been. Brookings … [has] a platform and a loud and respected voice, and with that comes substantial opportunity for real world impact.</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?quality=50&amp;w=1500" srcset="https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg 2383w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=150,150 150w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=300,300 300w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=768,768 768w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=1024,1024 1024w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=1536,1536 1536w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=2048,2048 2048w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=100,100 100w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=250,250 250w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=500,500 500w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=1000,1000 1000w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=1500,1500 1500w, https://www.brookings.edu/wp-content/uploads/2025/07/M.-Donoghoe.jpg?resize=2000,2000 2000w"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="">\n<h5>Manann Donoghoe</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Fellow</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="">Brookings Metro</a></span></span> </span>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>Brookings at its best is unsurpassed because of its commitment to rigorous and independent research focused on today’s key public policy challenges facing the nation and the world. Here at Brookings, we are limited only by our own imaginations and intellects, and we are blessed to do our work in a community of kind, collaborative, curious, and energetic colleagues of many interests, backgrounds, and demographics.\xa0I have been here nearly 30 years as a result, with no desire to end that run anytime soon.</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="https://www.brookings.edu/people/michael-e-ohanlon/">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="Michael O\'Hanlon" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?quality=50&amp;w=1000" srcset="https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg 2067w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=200,300 200w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=768,1152 768w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=683,1024 683w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=1024,1536 1024w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=1366,2048 1366w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=67,100 67w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=167,250 167w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=333,500 333w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=667,1000 667w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=1000,1500 1000w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=1334,2000 1334w, https://www.brookings.edu/wp-content/uploads/2016/06/ohanlonm.jpg?resize=1667,2500 1667w" style="object-position: 49.79% 27.41%;"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="https://www.brookings.edu/people/michael-e-ohanlon/">\n<h5>Michael E. O’Hanlon</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Director of Research</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="https://www.brookings.edu/people/michael-e-ohanlon/"><a class="text-link-underline" href="https://www.brookings.edu/programs/foreign-policy/">Foreign Policy</a>,</a></span></span> <span class="item"><span class="title">Director</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="https://www.brookings.edu/people/michael-e-ohanlon/"><a class="text-link-underline" href="https://www.brookings.edu/centers/strobe-talbott-center-for-security-strategy-and-technology/">Strobe Talbott Center for Security, Strategy, and Technology</a>,</a></span></span> <span class="item"><span class="title">Senior Fellow</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="https://www.brookings.edu/people/michael-e-ohanlon/"><a class="text-link-underline" href="https://www.brookings.edu/programs/foreign-policy/">Foreign Policy</a>, <a class="text-link-underline" href="https://www.brookings.edu/centers/strobe-talbott-center-for-security-strategy-and-technology/">Strobe Talbott Center for Security, Strategy, and Technology</a>,</a></span></span> <span class="item"><span class="title">Philip H. Knight Chair in Defense and Strategy</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="https://www.brookings.edu/people/michael-e-ohanlon/"></a></span></span> </span>\n<a class="twitter btn text-btn group" href="https://x.com/@MichaelEOHanlon" rel="noreferrer" target="_blank">\n<span class="text-twitter-blue w-3">\n\n</span>\n<span class="twitter-handle small text-dark-gray group-hover:text-skin-link-hover">\n\t\t\t\t\t\t\t\t@MichaelEOHanlon\n\t\t\t\t\t\t\t</span>\n</a>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>Working at Brookings is a breath of fresh air for professionalism and impact. Anyone wanting to make a difference in the world should want to work at Brookings. It is an honor to work here. You will make a difference and become a better person in the process.</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="https://www.brookings.edu/people/rashawn-ray/">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="Rashawn Ray" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?quality=50&amp;w=1001" srcset="https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg 3500w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=200,300 200w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=768,1151 768w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=683,1024 683w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=1025,1536 1025w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=1366,2048 1366w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=67,100 67w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=167,250 167w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=334,500 334w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=667,1000 667w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=1001,1500 1001w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=1334,2000 1334w, https://www.brookings.edu/wp-content/uploads/2019/06/Pic_2021_1.jpg?resize=1668,2500 1668w" style="object-position: 51.14% 13.48%;"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="https://www.brookings.edu/people/rashawn-ray/">\n<h5>Rashawn Ray</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Senior Fellow</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="https://www.brookings.edu/people/rashawn-ray/"><a class="text-link-underline" href="https://www.brookings.edu/programs/governance-studies/">Governance Studies</a>, <a class="text-link-underline" href="https://www.brookings.edu/projects/race-prosperity-and-inclusion-initiative/">Race, Prosperity, and Inclusion Initiative (RPII)</a></a></span></span> </span>\n<a class="twitter btn text-btn group" href="https://x.com/@SociologistRay" rel="noreferrer" target="_blank">\n<span class="text-twitter-blue w-3">\n\n</span>\n<span class="twitter-handle small text-dark-gray group-hover:text-skin-link-hover">\n\t\t\t\t\t\t\t\t@SociologistRay\n\t\t\t\t\t\t\t</span>\n</a>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>The best part of the Brookings culture is that it is a community of people who truly want to make a difference by helping others and society as a whole. My time at the Brookings Institution has been filled with rewarding experiences. I didn’t think I would stay for very long; 14 years later, I’m still here. My role has changed several times, introducing new and exciting ways to grow.</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2024/07/Carlos-Rondan.jpg?quality=50&amp;w=500" srcset="https://www.brookings.edu/wp-content/uploads/2024/07/Carlos-Rondan.jpg 500w, https://www.brookings.edu/wp-content/uploads/2024/07/Carlos-Rondan.jpg?resize=150,150 150w, https://www.brookings.edu/wp-content/uploads/2024/07/Carlos-Rondan.jpg?resize=300,300 300w, https://www.brookings.edu/wp-content/uploads/2024/07/Carlos-Rondan.jpg?resize=100,100 100w, https://www.brookings.edu/wp-content/uploads/2024/07/Carlos-Rondan.jpg?resize=250,250 250w"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="">\n<h5>Carlos Rondan</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Senior Systems Engineer</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="">Brookings Technology</a></span></span> </span>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n<div class="swiper-slide">\n<article class="article media-coverage media-coverage-updated testimonial">\n<hr/>\n<div class="article-insert">\n<div>\n<span class="article-insert-details">\n<div class="article-description">\n<span class="icon">\n\n</span>\n<div><p>I’ve never worked at a place where I can see the influence of any given output on policy debates more quickly. I have been afforded various opportunities at Brookings to explore my own research interests, author reports, and collaborate with some truly exceptional leaders in their respective fields. With so many events and interesting people roaming the halls, there is truly no shortage of possibilities, particularly for people with a range of different interests (like me!).</p>\n</div>\n</div>\n</span>\n</div>\n<span class="article-author-block">\n<div class="people">\n<div class="people-wrapper">\n<a class="photo expert-link" href="https://www.brookings.edu/people/valerie-wirtschafter/">\n<div class="img-wrapper relative overflow-hidden">\n<figure class="overflow-hidden relative aspect-[1/1] w-full rounded-full">\n<div class="img-wrapper">\n<img alt="Valerie Wirtschafter" class="" sizes="1500px" src="https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?quality=50&amp;w=1000" srcset="https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg 1718w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=200,300 200w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=768,1152 768w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=683,1024 683w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=1024,1536 1024w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=1366,2048 1366w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=67,100 67w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=167,250 167w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=333,500 333w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=667,1000 667w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=1000,1500 1000w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=1334,2000 1334w, https://www.brookings.edu/wp-content/uploads/2021/04/FP-20261002-valerie-wirtschafter.jpg?resize=1667,2500 1667w" style="object-position: 49.66% 29.29%;"/>\n</div>\n</figure>\n</div>\n</a>\n<div class="info">\n<a class="text-link-underline" href="https://www.brookings.edu/people/valerie-wirtschafter/">\n<h5>Valerie Wirtschafter</h5>\n</a>\n<span class="titles"> <span class="item"><span class="title">Fellow</span><span class="title-blurb">\n\t\t\t\t\t\t\t\t\t\t- <a class="text-link-underline" href="https://www.brookings.edu/people/valerie-wirtschafter/"><a class="text-link-underline" href="https://www.brookings.edu/programs/foreign-policy/">Foreign Policy</a>, <a class="text-link-underline" href="https://www.brookings.edu/projects/artificial-intelligence-and-emerging-technology-initiative/">Artificial Intelligence and Emerging Technology Initiative</a></a></span></span> </span>\n</div>\n</div>\n</div>\n</span>\n</div>\n</article>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div> </section>\n<s