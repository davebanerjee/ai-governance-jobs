ifferent departments. You will only be contacted if your background, expertise, availability, and services appear to align with a specific project need.</p>\n</div><!-- /body1 -->\n</div>\n</div><!-- /wrap1 -->\n<div class="wrap1 component_button">\n<div class="wrap1-inner -restrain">\n<div class="body1 -contain -wx:5">\n<p><a class="button1" href="https://airtable.com/appiyKpOPhsau9sVX/shrCwqROPF8lRMhB3" role="button" target="_blank"><span>Apply Now</span></a></p>\n</div><!-- /body1 -->\n</div>\n</div><!-- /wrap1 -->\n</section>\n\n<div @keydown.escape.window="$store.app.states.sidenav = false;" class="sidenav1 -cs:b3 -cs:i" id="sidenav" x-bind="transitions" x-cloak="" x-data="collapse()" x-show="$store.app.states.sidenav"> <div aria-hidden="true" class="decor1 -c:a5 -x5"> <div class="decor1-wrap"> <i class="icon-flag"></i> </div> </div><!-- /decor1 --> <div class="sidenav1-header"> <p class="sidenav1-close -as:0"><a @click.prevent="$store.app.states.sidenav = false" aria-label="Close" class="icon-close-bold" href="#"><span>Close</span></a></p> </div> <div class="sidenav1-wrap"> <ul class="sidenav1-main"> <li :class="{ \'-open\': open[\'m1\'] }"> <span> <i @click.prevent="toggle(\'m1\')" @keydown.enter="toggle(\'m1\')" class="icon-angle-down-bold" clickable="" scripted="" tabindex="0"></i> <a href="https://www.newamerica.org/issues/">Issues</a> </span> <ul class="sidenav1-drop" cloaked="" collapse="" x-bind="transitions" x-show="show(open[\'m1\'])"> <li><a href="https://www.newamerica.org/issues/education-and-work/">Education &amp; Work</a></li> <li><a href="https://www.newamerica.org/issues/democratic-futures/">Democratic Futures</a></li> <li><a href="https://www.newamerica.org/issues/thriving-families/">Thriving Families</a></li> <li><a href="https://www.newamerica.org/issues/global-security/">Global Security</a></li> <li><a href="https://www.newamerica.org/issues/technology-democracy/">Technology &amp; Democracy</a></li> </ul> </li> <li :class="{ \'-open\': open